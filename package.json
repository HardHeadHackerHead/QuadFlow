{
  "name": "quadflow-tauri",
  "private": true,
  "version": "2.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "predev": "node scripts/gen-shared-shims.mjs",
    "dev": "vite",
    "build": "tauri build",
    "prebuild:web": "node scripts/gen-shared-shims.mjs",
    "build:web": "tsc && vite build",
    "build:plugins": "node scripts/bundle-plugins.mjs",
    "preview": "vite preview",
    "tauri": "node scripts/ui/tauri-cli.mjs",
    "build:dev-exe": "tauri build --debug --no-bundle --config src-tauri/tauri.dev.conf.json",
    "ui": "node scripts/ui/cli.mjs",
    "test:e2e": "npm run build:dev-exe && npm run test:e2e:only",
    "test:e2e:only": "node --test --test-concurrency=1 scripts/ui/smoke.test.mjs scripts/ui/workspaces.test.mjs scripts/ui/theme.test.mjs scripts/ui/onboarding.test.mjs scripts/ui/import-v1.test.mjs scripts/ui/sandbox.test.mjs scripts/ui/devmode.test.mjs scripts/ui/plugin-cli.test.mjs scripts/ui/ideas.test.mjs scripts/ui/plans.test.mjs scripts/ui/ship.test.mjs scripts/ui/chat.test.mjs scripts/ui/missions.test.mjs scripts/ui/github.test.mjs scripts/ui/code-quality.test.mjs scripts/ui/scripts.test.mjs scripts/ui/editor.test.mjs scripts/ui/tui.test.mjs scripts/ui/web-preview.test.mjs scripts/ui/issues.test.mjs scripts/ui/external-apps.test.mjs scripts/ui/youtube-live.test.mjs scripts/ui/obs-tracker.test.mjs scripts/ui/discord-bot.test.mjs scripts/ui/local-titles.test.mjs scripts/ui/usage-monitor.test.mjs",
    "test:e2e:semantic": "npm run build:sidecar --workspace plugins/semantic-search && node --test scripts/ui/semantic-search.test.mjs",
    "build:plugins:dev": "node scripts/bundle-plugins.mjs --dev",
    "gen:plugin-index": "node scripts/gen-plugin-index.mjs",
    "check": "node scripts/check.mjs",
    "check:index": "node scripts/gen-plugin-index.mjs --check",
    "check:plugins": "node scripts/bundle-plugins.mjs --dev",
    "check:release": "node scripts/release.mjs validate",
    "release": "node scripts/release.mjs",
    "release:key": "node scripts/release/generate-updater-key.mjs",
    "docs:api": "typedoc --options docs/plugins/typedoc.json",
    "docs:manifest": "node scripts/gen-plugin-docs.mjs",
    "check:docs": "node scripts/gen-plugin-docs.mjs --check && typedoc --options docs/plugins/typedoc.json --emit none --treatWarningsAsErrors"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@quadflow/ui": "*",
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-mosaic-component": "^6.1.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.4.20",
    "playwright-core": "^1.48.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typedoc": "^0.27.9",
    "typescript": "~5.7.3",
    "vite": "^5.4.0"
  }
}
