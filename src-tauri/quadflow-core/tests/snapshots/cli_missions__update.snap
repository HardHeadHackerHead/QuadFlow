{
  "config": {
    "memberPromptExtra": "Use /issue-to-prompt for context. Use /run-script to validate. Move issues to QA when complete.",
    "orchestratorPromptExtra": "You are leading a Feature Build mission. Use /triage-issues to prioritize, assign issues to members. Have developers use /issue-to-prompt and /run-script.",
    "skillsUsed": [
      "issue-to-prompt",
      "run-script",
      "triage-issues",
      "create-rich-plan"
    ],
    "successCriteria": [
      "All linked issues reach QA or Done status",
      "Tests pass for all changed code",
      "Security review completed"
    ],
    "workflowPhases": [
      {
        "description": "Tech lead breaks down the feature into issues",
        "gate": "plan_created",
        "name": "Planning",
        "skills": [
          "triage-issues",
          "create-rich-plan"
        ]
      },
      {
        "description": "Developers work through assigned issues",
        "gate": "all_issues_in_progress",
        "name": "Implementation",
        "skills": [
          "issue-to-prompt",
          "run-script"
        ]
      },
      {
        "description": "QA validates each completed issue",
        "gate": "all_issues_in_qa",
        "name": "Testing",
        "skills": [
          "issue-to-prompt",
          "run-script"
        ]
      },
      {
        "description": "Security engineer audits the changes",
        "gate": "security_approved",
        "name": "Security Review",
        "skills": [
          "issue-to-prompt"
        ]
      },
      {
        "description": "All issues pass QA and security review",
        "gate": "all_issues_done",
        "name": "Done"
      }
    ]
  },
