{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuadFlow Dev",
  "identifier": "io.quadslab.quadflow.dev",
  "build": {
    "beforeDevCommand": "npm run build:plugins:dev && npm run dev",
    "beforeBuildCommand": "npm run build:plugins:dev && npm run build:web"
  },
  "app": {
    "windows": [
      {
        "title": "QuadFlow Dev",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "createUpdaterArtifacts": false
  }
}
