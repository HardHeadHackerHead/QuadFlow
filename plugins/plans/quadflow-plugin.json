{
  "$schema": "../../packages/plugin-api/schema/quadflow-plugin.schema.json",
  "id": "plans",
  "name": "Plans",
  "version": "1.0.0",
  "description": "Implementation plans: spec drafting and review, decomposition into steps, promotion of steps to issues, and a coordination view of the agents working them.",
  "author": { "name": "QuadFlow" },
  "license": "AGPL-3.0-only",
  "icon": "assets/icon.svg",
  "category": "project-management",
  "apiVersion": "^1.1.0",
  "platforms": ["windows", "macos", "linux"],
  "ui": { "entry": "dist/index.js", "style": "dist/index.css" },
  "activation": ["onTile", "onCommand"],
  "contributes": {
    "tiles": [
      {
        "id": "board",
        "title": "Plans",
        "description": "Plans of the current project: spec, steps, promotion and execution.",
        "modes": ["pane", "flyout"],
        "requiresProject": true,
        "templateable": true,
        "flyout": { "defaultSize": [560, 500] },
        "defaultToolConfig": { "order": 1, "color": "#7c3aed" }
      }
    ],
    "commands": [
      { "id": "new-plan", "title": "New Plan", "category": "Plans", "keywords": ["create", "add", "spec"], "when": "project" },
      { "id": "open", "title": "Open Plans", "category": "Plans", "palette": false }
    ],
    "paletteProviders": [{ "id": "plans", "title": "Plans" }],
    "agentContextDocs": [{ "id": "plans", "title": "Plans", "file": "docs/agent.md" }]
  },
  "permissions": ["data:plans:write", "data:issues:write", "data:ideas:read", "data:discovery:read", "agents:read", "agents:launch"]
}
