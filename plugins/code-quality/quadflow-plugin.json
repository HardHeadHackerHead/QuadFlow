{
  "$schema": "../../packages/plugin-api/schema/quadflow-plugin.schema.json",
  "id": "code-quality",
  "name": "Code Quality",
  "version": "1.0.0",
  "description": "Code metrics of the current project: lines of code per language, comment ratio, complexity, test ratio, a quality grade and an optional AI assessment.",
  "author": { "name": "QuadFlow" },
  "license": "AGPL-3.0-only",
  "icon": "assets/icon.svg",
  "category": "development",
  "apiVersion": "^1.4.0",
  "platforms": ["windows", "macos", "linux"],
  "ui": { "entry": "dist/index.js", "style": "dist/index.css" },
  "activation": ["onTile", "onCommand"],
  "contributes": {
    "tiles": [
      {
        "id": "report",
        "title": "Code Quality",
        "description": "Quality metrics of the current project.",
        "modes": ["pane", "flyout"],
        "requiresProject": true,
        "templateable": true,
        "flyout": { "defaultSize": [560, 500] },
        "defaultToolConfig": { "order": 6, "color": "#14b8a6" }
      }
    ],
    "commands": [
      { "id": "rescan", "title": "Rescan Code Quality", "category": "Code Quality", "keywords": ["scan", "metrics", "loc"], "when": "project" },
      { "id": "insight", "title": "Code Quality AI Insight", "category": "Code Quality", "keywords": ["assessment", "llm", "chat"], "when": "project" }
    ]
  },
  "permissions": ["fs:read:project", "data:chat:write"]
}
