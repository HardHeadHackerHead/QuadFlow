{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quadflow.dev/schema/quadflow-plugin.schema.json",
  "title": "QuadFlow plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "apiVersion",
    "platforms"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\.[a-z][a-z0-9]*(-[a-z0-9]+)*)?$",
      "description": "Bare ids (no dot) are reserved for the official source. Others must be publisher.name."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "license": {
      "type": "string"
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "icon": {
      "$ref": "#/$defs/relPath",
      "description": "SVG (preferred) or PNG, relative to plugin root."
    },
    "category": {
      "$ref": "#/$defs/category"
    },
    "apiVersion": {
      "type": "string",
      "description": "semver range of @quadflow/plugin-api, e.g. ^1.2.0"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "windows",
          "macos",
          "linux"
        ]
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry"
      ],
      "properties": {
        "entry": {
          "$ref": "#/$defs/relPath"
        },
        "style": {
          "$ref": "#/$defs/relPath"
        }
      }
    },
    "activation": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "onStartup",
          "onProject",
          "onTile",
          "onCommand",
          "onCli",
          "onAgentProvider"
        ]
      },
      "description": "When the UI module's activate() runs. Default [\"onTile\",\"onCommand\"]."
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tile"
          }
        },
        "toolbarItems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolbarItem"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "contextMenus": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contextMenu"
          }
        },
        "settingsPages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/settingsPage"
          }
        },
        "settings": {
          "$ref": "#/$defs/jsonSchemaObject"
        },
        "cliCommands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cliCommand"
          }
        },
        "agentContextDocs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agentContextDoc"
          }
        },
        "paletteProviders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/paletteProvider"
          },
          "description": "Command-palette entity search; the UI module exports paletteProviders[id]."
        },
        "titleGenerators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/titleGenerator"
          },
          "description": "Terminal-title generators (API 1.3); the UI module exports titleGenerators[id]."
        },
        "agentProvider": {
          "$ref": "https://quadflow.dev/schema/agent-provider.schema.json"
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/permission"
      }
    },
    "sidecar": {
      "$ref": "#/$defs/sidecar"
    }
  },
  "$defs": {
    "relPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\)[A-Za-z0-9._/-]+$"
    },
    "contribId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "category": {
      "enum": [
        "project-management",
        "development",
        "ai-agents",
        "media",
        "system",
        "integrations",
        "other"
      ]
    },
    "jsonSchemaObject": {
      "type": "object",
      "description": "JSON Schema (draft 2020-12) with type=object; rendered by @quadflow/ui FormFromSchema."
    },
    "when": {
      "type": "string",
      "description": "Context expression (§5.5), e.g. \"project && !terminal.agent\""
    },
    "tile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/contribId"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "$ref": "#/$defs/relPath"
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "modes": {
          "type": "array",
          "items": {
            "enum": [
              "pane",
              "flyout"
            ]
          },
          "default": [
            "pane",
            "flyout"
          ]
        },
        "singleton": {
          "type": "boolean",
          "default": false,
          "description": "At most one instance per workspace."
        },
        "requiresProject": {
          "type": "boolean",
          "default": false
        },
        "templateable": {
          "type": "boolean",
          "default": false,
          "description": "Offered in workspace templates."
        },
        "miniWidget": {
          "type": "boolean",
          "default": false,
          "description": "UI module exports a mini toolbar widget for this tile."
        },
        "flyout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "defaultSize": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 200
              },
              "minItems": 2,
              "maxItems": 2
            },
            "minSize": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 200
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "configSchema": {
          "$ref": "#/$defs/jsonSchemaObject",
          "description": "Per tool-config settings (e.g. executable path for TUI)."
        },
        "instanceMultiple": {
          "type": "boolean",
          "default": true,
          "description": "Allow multiple tool configs of this tile (e.g. many TUI tools)."
        },
        "defaultToolConfig": {
          "$ref": "#/$defs/defaultToolConfig"
        }
      }
    },
    "toolbarItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "command"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/contribId"
        },
        "title": {
          "type": "string"
        },
        "icon": {
          "$ref": "#/$defs/relPath"
        },
        "command": {
          "type": "string",
          "description": "Command id in this plugin, or <pluginId>/<commandId>."
        },
        "category": {
          "$ref": "#/$defs/category",
          "description": "Menu group; defaults to the plugin's category."
        },
        "miniWidget": {
          "type": "boolean",
          "default": false
        },
        "configSchema": {
          "$ref": "#/$defs/jsonSchemaObject",
          "description": "Per tool-config settings (e.g. the shell of a terminal button); the command receives the tool config id."
        },
        "instanceMultiple": {
          "type": "boolean",
          "default": false,
          "description": "Allow user-created tool configs of this item (e.g. several window links)."
        },
        "defaultToolConfig": {
          "$ref": "#/$defs/defaultToolConfig"
        }
      }
    },
    "defaultToolConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "pinned": {
          "type": "boolean",
          "default": false
        },
        "pinSection": {
          "enum": [
            "left",
            "center",
            "right"
          ],
          "default": "right"
        },
        "pinDisplay": {
          "enum": [
            "icon",
            "icon-and-name",
            "mini"
          ],
          "default": "icon-and-name"
        },
        "quickLaunch": {
          "type": "boolean",
          "default": false
        },
        "openMode": {
          "enum": [
            "pane",
            "flyout"
          ],
          "default": "pane"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "order": {
          "type": "integer",
          "default": 100
        },
        "settings": {
          "type": "object"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/contribId"
        },
        "title": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "icon": {
          "$ref": "#/$defs/relPath"
        },
        "shortcut": {
          "type": "string",
          "pattern": "^((Ctrl|Cmd|Alt|Shift|Mod)\\+)*([A-Za-z0-9`\\-=\\[\\];',./]|F[0-9]{1,2})$"
        },
        "palette": {
          "type": "boolean",
          "default": true
        },
        "when": {
          "$ref": "#/$defs/when"
        }
      }
    },
    "contextMenu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "location",
        "command",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/contribId"
        },
        "location": {
          "enum": [
            "terminal",
            "terminal.selection",
            "tile.header",
            "tab",
            "project",
            "workspace",
            "entity.issue",
            "entity.idea",
            "entity.plan",
            "file"
          ]
        },
        "command": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "when": {
          "$ref": "#/$defs/when"
        }
      }
    },
    "settingsPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/contribId"
        },
        "title": {
          "type": "string"
        },
        "icon": {
          "$ref": "#/$defs/relPath"
        },
        "custom": {
          "type": "boolean",
          "default": false,
          "description": "true: UI module exports settingsPages[id] component; false: auto form from contributes.settings."
        }
      }
    },
    "cliCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "summary",
        "handler"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,31}$"
        },
        "summary": {
          "type": "string",
          "maxLength": 120
        },
        "docs": {
          "$ref": "#/$defs/relPath"
        },
        "handler": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "sidecar"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "binaries"
              ],
              "properties": {
                "type": {
                  "const": "exec"
                },
                "binaries": {
                  "$ref": "#/$defs/binaries"
                }
              }
            }
          ]
        }
      }
    },
    "paletteProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/contribId"
        },
        "title": {
          "type": "string",
          "description": "Group label of the results in the palette."
        }
      }
    },
    "titleGenerator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/contribId"
        },
        "title": {
          "type": "string",
          "description": "Name shown in Settings → Integrations → Auto Titles."
        }
      }
    },
    "agentContextDoc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "file"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "title": {
          "type": "string"
        },
        "file": {
          "$ref": "#/$defs/relPath"
        },
        "default": {
          "type": "boolean",
          "default": false,
          "description": "Enabled by default in new projects when the plugin is enabled."
        }
      }
    },
    "binaries": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "patternProperties": {
        "^(windows|macos|linux)-(x86_64|aarch64)$": {
          "$ref": "#/$defs/relPath"
        }
      }
    },
    "sidecar": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "binaries"
          ]
        },
        {
          "required": [
            "runtime",
            "entry"
          ]
        }
      ],
      "properties": {
        "binaries": {
          "$ref": "#/$defs/binaries"
        },
        "runtime": {
          "enum": [
            "node"
          ],
          "description": "Interpreter located on PATH; plugin requires permission sidecar:runtime:node."
        },
        "entry": {
          "$ref": "#/$defs/relPath"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "activation": {
          "enum": [
            "onDemand",
            "onStartup"
          ],
          "default": "onDemand"
        },
        "restart": {
          "enum": [
            "onCrash",
            "never"
          ],
          "default": "onCrash"
        }
      }
    },
    "permission": {
      "type": "string",
      "pattern": "^(data:(ideas|issues|plans|discovery|scripts|ship|chat|missions):(read|write)|project:config:write|terminal:(spawn|io)|agents:(launch|read)|fs:(read|write):(project|home|any)|shell:exec:[A-Za-z0-9._-]+|shell:open-external|network:(\\*|[a-z0-9.-]+(:[0-9]+)?)|notifications|clipboard:(read|write)|secrets|native:(windows|webview|screen-capture)|sidecar:runtime:node)$"
    }
  }
}
